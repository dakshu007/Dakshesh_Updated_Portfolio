# Contact form delivery (Formspree).
# 1. Create a form at https://formspree.io and copy its endpoint.
# 2. Paste it below, then copy this file to .env.local
# Example: https://formspree.io/f/abcdwxyz
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id

# Canonical site origin. Defaults to https://dakshesh.co.in when unset.
NEXT_PUBLIC_SITE_URL=https://dakshesh.co.in

# Live results (/results and the home page "Live results" section).
# Windsor.ai API key, from https://onboard.windsor.ai (Account > API key).
# Server-side only: never prefix it with NEXT_PUBLIC. Without it the site
# shows the committed snapshot in lib/analytics/snapshot.json.
WINDSOR_API_KEY=
